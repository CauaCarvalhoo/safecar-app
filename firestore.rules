rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, create, update: if request.auth != null
                                  && request.auth.uid == userId;

      allow delete: if false;

      match /vehicles/{vehicleId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      match /alerts/{alertId} {
        allow read, create, delete: if request.auth != null
                                    && request.auth.uid == userId;

        allow update: if false;
      }

      match /fleetAlerts/{alertId} {
        allow read, create, delete: if request.auth != null
                                    && request.auth.uid == userId;

        allow update: if false;
      }

      match /trips/{tripId} {
        allow read, create, update, delete: if request.auth != null
                                            && request.auth.uid == userId;
      }
    }

    // Nova estrutura multiempresa (leitura habilitada apenas para membros).
    // Provisionamento de organizacoes, membros e dados compartilhados deve ser
    // executado exclusivamente por um backend autenticado (Admin SDK).
    // As colecoes legadas /users permanecem inalteradas.
    match /organizations/{organizationId} {
      function memberPath() {
        return /databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid);
      }

      function isActiveMember() {
        return request.auth != null &&
          exists(memberPath()) &&
          get(memberPath()).data.active == true;
      }

      function isOrganizationAdmin() {
        return isActiveMember() &&
          get(memberPath()).data.role in ['owner', 'admin'];
      }

      allow read: if isActiveMember();
      allow write: if false;

      match /members/{memberId} {
        allow read: if isActiveMember() &&
          (memberId == request.auth.uid || isOrganizationAdmin());
        allow write: if false;
      }

      match /vehicles/{vehicleId} {
        allow read: if isActiveMember();
        allow write: if false;
      }

      match /drivers/{driverId} {
        allow read: if isActiveMember();
        allow write: if false;
      }

      match /trips/{tripId} {
        allow read: if isActiveMember();
        allow write: if false;
      }

      match /alerts/{alertId} {
        allow read: if isActiveMember();
        allow write: if false;
      }

      match /devices/{deviceId} {
        allow read: if isActiveMember();
        allow write: if false;
      }
    }
  }
}